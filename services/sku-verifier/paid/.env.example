# Deploy this as a separate public webserver. Never ship this file with credentials.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/sku_paid?sslmode=verify-full
ALIPAY_ENVIRONMENT=production
ALIPAY_APP_ID=
ALIPAY_SERVICE_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
DEEPSEEK_API_KEY=
SKU_PRICE_FEN=99
SKU_GOODS_NAME=SKU规格证据核验
SKU_EXECUTION_TIMEOUT_MS=780000
PORT=8000
# Integration tests require an explicitly selected disposable test database.
# SKU_TEST_DATABASE_URL=postgresql://localhost/sku_paid_test
